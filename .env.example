# The shared password the four of you type once to open the journal.
# Changing it later signs everyone out (they just sign in again).
TRIP_PASSCODE=pick-something-only-you-four-know

# Vercel adds the Blob credentials for you when you connect a Blob store to the project.
# For local dev only: run `vercel env pull .env.local`, or paste the store's read-write token here.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
