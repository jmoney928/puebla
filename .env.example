# Jack's password for the small login at the bottom of the blog (lets him post, edit and delete).
# Changing it logs Jack out on every device.
JACK_PASSWORD=pick-something-only-jack-knows

# Vercel adds the Blob credentials for you when you connect a Blob store to the project.
# For local dev only: run `vercel env pull .env.local`, or paste the store's read-write token here.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
